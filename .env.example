# Sponsor payment flow — environment variables.
# Copy to .env.local for development. NEVER commit real secrets.
# Build + test everything in Stripe TEST mode first (sk_test_… / whsec_… from `stripe listen`).

# --- Stripe (required) ---
# Secret key from the Stripe Dashboard (use a TEST key while developing).
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret. In dev, run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and paste the printed whsec_… here. In prod, copy it from the registered webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Publishable key. OPTIONAL — the Checkout redirect flow does not need it; only set
# if you later add Stripe.js on the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Tier amounts are defined SERVER-SIDE in lib/sponsors/tiers.ts using dynamic
# price_data (authoritative, never trusts the client). Pre-created Stripe Price IDs
# are intentionally NOT used, so STRIPE_PRICE_* are unnecessary.

# --- Site ---
# Absolute origin used to build Stripe success/cancel URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
# Used for the internal organizer notification + non-payment confirmation emails.
# Payment/invoice confirmations ride on Stripe's built-in emails. If unset, email
# steps are skipped (non-fatal).
RESEND_API_KEY=
# Where new-sponsor notifications are sent.
SPONSOR_NOTIFY_EMAIL=support@southwestmnhacks.org
# Verified Resend sender. Defaults to Resend's onboarding domain for dev; switch to
# a verified southwestmnhacks.org address at go-live (e.g. "Southwest MN Hacks <sponsors@southwestmnhacks.org>").
RESEND_FROM_EMAIL=

# --- Invoicing behavior ---
# false (default): create invoices as DRAFT for manual review before sending.
# true: finalize and send invoices automatically.
SPONSOR_AUTO_SEND_INVOICES=false
# Net terms for invoices, in days.
SPONSOR_INVOICE_DAYS_UNTIL_DUE=30

# --- Notion (sponsor pipeline tracker) ---
# Internal integration token (ntn_… / secret_…) from a Notion internal integration
# that has been shared with the "Southwest MN Hacks — Sponsors" database, plus that
# database's DATA SOURCE id. If unset, Notion sync is skipped (non-fatal) — Stripe
# stays the source of truth.
# Provisioned data source id: 118000e5-8953-4aeb-9d65-5bc56dcf50f4
# (database page: https://app.notion.com/p/5151e9c480f44fbeb192908554cca809)
NOTION_TOKEN=
NOTION_SPONSORS_DATA_SOURCE_ID=118000e5-8953-4aeb-9d65-5bc56dcf50f4
